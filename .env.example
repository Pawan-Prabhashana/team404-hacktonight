# =============================================================================
# Serandib Bank — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
#
# There are two ways to run this project:
#
#   A) Full Docker (recommended):
#      cp .env.example .env.local
#      docker compose up --build --watch
#      -- DATABASE_URL uses 'db' because that is the Docker service name
#
#   B) Local dev server + Docker DB only:
#      cp .env.example .env.local
#      Change DATABASE_URL below to use 'localhost' instead of 'db'
#      docker compose up db -d
#      bun run dev
#
# =============================================================================

POSTGRES_USER=postgresql
POSTGRES_PASSWORD=supersecurepassword
POSTGRES_DB=htn26db

# --- Option A: Full Docker (app + db both in containers) ---
# DATABASE_URL=postgresql://postgresql:supersecurepassword@db:5432/htn26db

# --- Option B: Local dev server, Docker for DB only ---
DATABASE_URL=postgresql://postgresql:supersecurepassword@localhost:5432/htn26db
